# 复制本文件为 .env 并填入真实值（.env 已被 gitignore 排除，不会提交）
# 线上请在服务器 / 部署平台配置同名环境变量

# ---------- PostgreSQL ----------
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your-db-password
PG_DATABASE=postgres

# ---------- 硅基流动（SiliconFlow） ----------
# Key 申请地址: https://cloud.siliconflow.cn
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# ---------- JWT ----------
# 上线必须替换为随机强密钥（可用 openssl rand -base64 48 生成），切勿用默认值
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=7d

# ---------- CORS ----------
# 允许跨域的前端域名（逗号分隔），上线时配置你的前端正式域名；留空 = 允许所有来源（仅本地开发）
CORS_ORIGINS=https://your-app.com

# ---------- 支付宝 AI 付（aipay.alipay.com） ----------
# 沙箱联调用沙箱网关和沙箱密钥；真实收款去 AI 付控制台拿线上密钥
# 切线上：换下面 4 项（APPID / 应用私钥 / 支付宝公钥），并把网关改成
# https://openapi.alipay.com/gateway.do （4 项必须一起换，否则直接报错）
ATPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ATPAY_APP_ID=your-alipay-app-id

# 支付宝公钥（控制台与「应用公钥」并排展示，用于验证异步通知签名）
ATPAY_ALIPAY_PUBLIC_KEY=your-alipay-public-key

# 应用公钥（仅上传支付宝备案用，代码里不使用）
ATPAY_PUBLIC_KEY=your-app-public-key

# 应用私钥（Node.js / 非 Java 格式）
ATPAY_PRIVATE_KEY=your-app-private-key

# 支付完成后浏览器回跳地址（先回后端 /pay/return，再 302 到前端结果页）
ATPAY_RETURN_URL=http://localhost:3000/pay/return

# 前端页面地址（本地开发为 Vite dev server）
ATPAY_FRONT_URL=http://localhost:5173

# 支付成功异步通知地址（必须公网可访问；本地留空靠查询接口兜底，部署后填公网后端地址）
ATPAY_NOTIFY_URL=
